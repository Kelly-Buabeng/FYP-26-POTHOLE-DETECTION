SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

MODEL_PATH=ml/weights/best.pt
CONFIDENCE_THRESHOLD=0.35

# API authentication — required as an X-API-Key header on POST /detect,
# GET /detections/export, and DELETE /detections/{id}. Leaving this unset
# (or as this placeholder) disables the check — dev/test only, never in
# production; the server logs a startup warning when this is the case.
API_KEY=change-this-in-production

# Ghana bounding box (defaults are already correct — only change if needed)
GHANA_LAT_MIN=4.5
GHANA_LAT_MAX=11.5
GHANA_LNG_MIN=-3.5
GHANA_LNG_MAX=1.5
