SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

MODEL_PATH=ml/weights/best.pt
CONFIDENCE_THRESHOLD=0.35

# API authentication — required as an X-API-Key header on POST /detect,
# GET /detections/export, and DELETE /detections/{id}. Leaving this unset
# (or as this placeholder) disables the check — dev/test only. If APP_ENV=production,
# the server refuses to start when this is unset/placeholder.


# Comma-separated list of exact frontend origin(s) allowed to call this API
# (e.g. https://your-frontend.vercel.app). Defaults to localhost dev servers
# only. If APP_ENV=production, the server refuses to start if this still
# includes "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# development or production — set to production on your deployed host
# (Railway, Render, etc.) to enforce API_KEY and CORS_ORIGINS above.
APP_ENV=development

# Ghana bounding box (defaults are already correct — only change if needed)
GHANA_LAT_MIN=4.5
GHANA_LAT_MAX=11.5
GHANA_LNG_MIN=-3.5
GHANA_LNG_MAX=1.5
